# === Telegram ===
BOT_TOKEN=
ADMIN_TELEGRAM_IDS=123456789
BOT_USERNAME=

# === Database ===
# Локально по умолчанию SQLite (файл рядом с проектом). Для прода — postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# === Redis (опционально; при пустом значении используется MemoryStorage) ===
REDIS_URL=

# === Cabinet (Mini App) ===
# CABINET_ENABLED=true поднимает FastAPI (/cabinet/*) на CABINET_PORT в том же процессе.
CABINET_ENABLED=false
CABINET_JWT_SECRET=
# Через запятую, без пробелов, напр. https://your-ngrok-domain.ngrok-free.app
CABINET_ALLOWED_ORIGINS=
CABINET_PORT=8080
# Публичный https-адрес задеплоенного Mini App (тот же домен, что и выше) —
# без него кнопка "Подключить VPN" в боте остаётся на прежнем прямом happ://-fallback.
MINIAPP_URL=

# === Remnawave ===
# REMNAWAVE_MODE=mock — используется заглушка (MockRemnawaveClient), реальный API не вызывается.
# REMNAWAVE_MODE=real — используется настоящий клиент (нужны REMNAWAVE_BASE_URL/REMNAWAVE_API_KEY).
REMNAWAVE_MODE=mock
REMNAWAVE_BASE_URL=
REMNAWAVE_API_KEY=
# Опционально: если nginx перед панелью маскирует её за секретным query-параметром
# (в его конфиге это выглядит как `map $arg_XXXXXXXX ...`) — без него ЛЮБОЙ запрос,
# включая /api/*, обрывается без ответа. Формат "key=value", напр. IxDUamBh=sAGAxRhd.
# Если такого маскирования нет — оставьте пустым.
REMNAWAVE_PANEL_SECRET_PARAM=

# === Платежи ===
# PAYMENTS_MODE=stub — оплата эмулируется мгновенным успехом, внешние API не вызываются.
# PAYMENTS_MODE=real — используются реальные ключи ниже.
PAYMENTS_MODE=stub

PLATEGA_MERCHANT_ID=
PLATEGA_SECRET_KEY=
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_API_VERSION=v1
# Код способа оплаты из личного кабинета Platega (СБП/карты/каскад) — сверьте у Platega,
# значение по умолчанию не гарантированно подходит вашему мерчанту.
PLATEGA_PAYMENT_METHOD_CODE=2

# === TON Connect — оплата переводом на кошелёк, подтверждение поллингом TON Center ===
TON_WALLET_ADDRESS=
# Пусто — работаем без ключа (публичный API с рейт-лимитом). Бесплатный ключ у @tonapibot.
TONCENTER_API_KEY=
# Сколько копеек в 1 TON — источник истины для суммы перевода, НЕ только для отображения.
# Курс TON гуляет сильно, обновляйте руками под актуальный.
TON_RATE_KOPEKS=30000

# Курс для ОТОБРАЖЕНИЯ цены в ★ на экране оплаты (не источник истины для реальных
# платежей — приблизительно, настройте под актуальный курс)
STARS_RATE_KOPEKS=130

# === Реферальная программа / промокоды ===
REFERRAL_PERCENT=25

# === Тариф по умолчанию (для сид-скрипта) ===
DEFAULT_TARIFF_NAME=Standard
